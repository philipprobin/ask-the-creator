# ── Ask the Creator — environment ──
# Copy to .env.local and fill in. You can also set keys in-app on first run
# (they're saved to data/config.json). Environment variables always win.

# ── Required ──
# OpenAI: embeddings + answer generation. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Recommended ──
# YouTube Data API v3: channel search + video metadata (free).
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Supadata: fetches YouTube transcripts reliably from any IP (free tier).
# Required for real transcripts (keyless extraction is blocked by YouTube).
# https://supadata.ai
SUPADATA_API_KEY=

# ── Storage (optional) ──
# Default: local SQLite file (zero setup). Set DATABASE_URL to use Postgres +
# pgvector instead (recommended for hosted/serverless, e.g. Supabase/Neon).
# STORAGE_BACKEND can force "sqlite" | "pgvector" | "memory"; auto-detected otherwise.
DATABASE_URL=
# STORAGE_BACKEND=
# SQLITE_PATH=data/ask-the-creator.db

# ── Optional tuning ──
# Below this many estimated transcript tokens, the full transcript is stuffed
# into the model context (no vector DB needed); above it, RAG kicks in.
# LLM_ONLY_MAX_TOKENS=100000
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional: password-protect the whole app (leave empty for open access).
SITE_PASSWORD=
